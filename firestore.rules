rules_version = '2';

// =============================================================================
// TN-170 Attendance — Firestore security rules (Spark / public-kiosk model)
// =============================================================================
// SECURITY MODEL & KNOWN EXPOSURE (read docs/SECURITY.md for the full assessment
// and migration plan):
//
// This is an UNAUTHENTICATED public kiosk. There is no Firebase Authentication,
// so these rules can validate the SHAPE of a write but cannot verify WHO is
// writing. Consequently, with only these rules, an unauthenticated client can
// still READ roster names, attendance, guest contact info, activity, and the
// (crackable, 4-digit) PIN hashes, and can CREATE shaped documents. That is
// inherent to a no-Auth kiosk and CANNOT be closed by rules alone.
//
// The safe, non-kiosk-breaking hardening applied here:
//   * Member create/update cannot grant admin permissions to a cadet grade
//     (permission flags must match the grade — no privilege escalation via flags).
//   * Clients can no longer write `systemForceCompletedDate` on meetings; only the
//     trusted server-side GitHub Actions job (Admin SDK, bypasses rules) sets it.
//   * Automation audit records (automationRuns) are read-only to clients.
//
// The real containment for the read/PIN exposure is Firebase App Check
// (reCAPTCHA v3, free on Spark) + enforcement on Firestore, plus moving PIN
// verification server-side. See docs/SECURITY.md. Do NOT loosen these rules.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function isActiveMember(capid) {
      return exists(/databases/$(database)/documents/members/$(capid))
        && get(/databases/$(database)/documents/members/$(capid)).data.active == true;
    }

    function memberPinResetRequired(capid) {
      return get(/databases/$(database)/documents/members/$(capid)).data.pinResetRequired == true;
    }

    function memberPinDocHasValidHash(data) {
      return data.keys().hasAll(['pinHash'])
        && data.pinHash is string
        && data.pinHash.size() >= 8
        && (data.pinHash.matches('^sha256:.*') || data.pinHash.matches('^fnv1a:.*'));
    }

    function isValidMeetingDate(dateStr) {
      return dateStr is string && dateStr.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function validAttendanceStatus(status) {
      return status in ['checked_in', 'checked_out'];
    }

    function validMemberGrade(grade) {
      return grade is string && grade.size() > 0;
    }

    function isCadetGrade(grade) {
      let upper = grade.upper();
      return upper.matches('^C/.*') || upper == 'CADET';
    }

    function memberRoleMatchesGrade(grade, role, isCadet, isSeniorMember) {
      let cadet = isCadetGrade(grade);
      return (cadet && role == 'Cadet' && isCadet == true && isSeniorMember == false)
        || (!cadet && role == 'Senior Member' && isCadet == false && isSeniorMember == true);
    }

    // Permission flags must equal (grade is senior). Prevents a cadet-grade member
    // from being created/updated with admin permissions via the open write path.
    function memberPermsMatchGrade(data) {
      let senior = !isCadetGrade(data.grade);
      return data.isAdmin == senior
        && data.canForceAttendance == senior
        && data.canResetPins == senior
        && data.canExportReports == senior
        && data.canManageMembers == senior
        && data.canManageGuests == senior;
    }

    function validMemberCreate(capid) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'memberId', 'capid', 'grade', 'firstName', 'lastName', 'fullName', 'displayName',
          'normalizedName', 'role', 'isCadet', 'isSeniorMember', 'isProspective', 'hasPin',
          'pinResetRequired', 'active', 'isAdmin', 'canForceAttendance', 'canResetPins',
          'canExportReports', 'canManageMembers', 'canManageGuests'
        ])
        && data.capid == capid
        && data.memberId == capid
        && data.temporaryId == null
        && data.isProspective == false
        && data.active == true
        && data.hasPin == false
        && data.pinResetRequired == false
        && validMemberGrade(data.grade)
        && memberRoleMatchesGrade(data.grade, data.role, data.isCadet, data.isSeniorMember)
        && memberPermsMatchGrade(data);
    }

    function validMemberProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'firstName', 'middleName', 'lastName', 'fullName', 'displayName', 'normalizedName',
          'grade', 'role', 'isCadet', 'isSeniorMember',
          'isAdmin', 'canForceAttendance', 'canResetPins', 'canExportReports',
          'canManageMembers', 'canManageGuests',
          'active', 'updatedAt', 'updatedByCapid', 'updatedByName',
          'deactivatedAt', 'deactivatedByCapid', 'deactivationReason',
          'reactivatedAt', 'reactivatedByCapid'
        ])
        && memberRoleMatchesGrade(
          request.resource.data.grade,
          request.resource.data.role,
          request.resource.data.isCadet,
          request.resource.data.isSeniorMember
        )
        && memberPermsMatchGrade(request.resource.data);
    }

    // Member roster — readable for kiosk search; limited client writes.
    match /members/{capid} {
      allow read: if true;
      allow delete: if false;
      allow create: if validMemberCreate(capid);
      allow update: if (isActiveMember(capid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['pinResetRequired', 'hasPin', 'updatedAt']))
        || validMemberProfileUpdate();
    }

    // PIN hashes — Spark kiosk reads hash for client-side verify; never plaintext.
    // NOTE: readable hashes of 4-digit PINs are crackable offline; App Check +
    // server-side verification is the migration path (docs/SECURITY.md).
    match /memberPins/{capid} {
      allow read: if true;
      allow delete: if isActiveMember(capid);
      allow create: if isActiveMember(capid)
        && !exists(/databases/$(database)/documents/memberPins/$(capid))
        && request.resource.data.keys().hasAll(['pinHash', 'pinCreatedAt', 'pinUpdatedAt'])
        && request.resource.data.pinHash is string
        && request.resource.data.pinHash.size() >= 8;
      allow update: if isActiveMember(capid)
        && (memberPinResetRequired(capid) || !memberPinDocHasValidHash(resource.data))
        && request.resource.data.keys().hasAll(['pinHash', 'pinUpdatedAt'])
        && request.resource.data.pinHash is string
        && request.resource.data.pinHash.size() >= 8;
    }

    // Meetings — kiosk creates/marks today's active meeting in_progress.
    // systemForceCompletedDate is NOT client-writable (server-only via Admin SDK).
    match /meetings/{meetingId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['meetingDate', 'status'])
        && isValidMeetingDate(request.resource.data.meetingDate)
        && request.resource.data.status == 'in_progress';
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'endTime', 'updatedAt'])
        && request.resource.data.status == 'in_progress';
      allow delete: if false;
    }

    // Member attendance — kiosk check-in/out (no Auth).
    match /attendanceRecords/{recordId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll([
          'meetingId', 'memberId', 'memberName', 'status', 'checkInTime'
        ])
        && validAttendanceStatus(request.resource.data.status)
        && request.resource.data.status == 'checked_in'
        && isActiveMember(request.resource.data.memberId);
      allow update: if validAttendanceStatus(resource.data.status)
        && validAttendanceStatus(request.resource.data.status)
        && resource.data.status == 'checked_in'
        && request.resource.data.status == 'checked_out'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status', 'checkOutTime', 'durationMinutes', 'checkedOutBy',
            'forceAction', 'forceActionBy', 'forceType', 'notes', 'updatedAt'
          ]);
      allow delete: if false;
    }

    // Recurring guest profiles.
    match /guests/{guestId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['fullName', 'normalizedName', 'active'])
        && request.resource.data.active == true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'fullName', 'normalizedName', 'hostCapid', 'hostName',
          'email', 'phone',
          'lastVisitDate', 'totalVisits', 'active', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // Guest attendance per meeting. NOTE: guest email/phone are readable here;
    // Firestore reads are all-or-nothing per document, so the kiosk guest table
    // cannot be shown without exposing these fields under the no-Auth model.
    match /guestAttendanceRecords/{recordId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll([
          'meetingId', 'guestId', 'guestName', 'status', 'checkInTime'
        ])
        && request.resource.data.status == 'checked_in'
        && (
          !request.resource.data.keys().hasAny(['signInMode', 'isOpenHouse'])
          || (
            request.resource.data.signInMode == 'open_house'
            && request.resource.data.isOpenHouse == true
          )
        );
      allow update: if resource.data.status == 'checked_in'
        && request.resource.data.status == 'checked_out'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status', 'checkOutTime', 'durationMinutes', 'checkedOutBy',
            'forceAction', 'forceType', 'notes', 'updatedAt'
          ]);
      allow delete: if false;
    }

    // Activity feed — append-only from kiosk.
    match /activityLog/{logId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['activityType', 'timestamp'])
        && request.resource.data.activityType is string
        && request.resource.data.activityType.size() <= 64;
      allow update, delete: if false;
    }

    // Automation audit / idempotency records — written ONLY by the server-side
    // GitHub Actions jobs (Admin SDK bypasses rules). Read-only to clients so a
    // future diagnostics view can show delivery status; never client-writable.
    match /automationRuns/{runId} {
      allow read: if true;
      allow write: if false;
    }

    match /reportExports/{exportId} {
      allow read: if true;
      allow write: if false;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
