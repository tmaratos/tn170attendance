VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
# Set to true when using Firebase emulators locally
VITE_FIREBASE_EMULATOR=false
# Spark (free): kiosk mode - Firestore roster + Firestore-synced attendance/PINs. Default on Spark (no Blaze).
# Set to false only if Blaze + Functions are deployed and you want callable-function backend.
VITE_FIREBASE_FREE_MODE=true
# Optional: Firebase App Check (reCAPTCHA v3) site key. Leave blank to disable.
# When set AND App Check is enforced on Firestore in the console, off-domain scripted
# access to the public collections is blocked. See docs/SECURITY.md.
VITE_RECAPTCHA_SITE_KEY=
# Optional: overrides the build version shown in Operational Diagnostics (else git SHA).
VITE_COMMIT_SHA=
